# Plantilla del entorno local de pruebas. Copiar a .env.testing (no versionado)
# y completar las credenciales locales de MySQL/MariaDB.
#
# Tests\TestCase bloquea cualquier prueba que no este conectada a la base
# lpz_saas_testing en un host local (127.0.0.1, localhost o ::1).

APP_NAME=Bagisto
APP_ENV=testing
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_ADMIN_URL=admin
APP_TIMEZONE=
APP_LOCALE=
APP_FALLBACK_LOCALE=
APP_FAKER_LOCALE=
APP_CURRENCY=
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=4

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=lpz_saas_testing
DB_USERNAME=
DB_PASSWORD=
DB_PREFIX=

CACHE_STORE=array
SESSION_DRIVER=array
QUEUE_CONNECTION=sync
MAIL_MAILER=array
# BROADCAST_DRIVER y LOG_CHANNEL se omiten a proposito: Laravel convierte el texto
# "null" en el valor PHP null y dejaria sin driver a esos servicios. Sin la variable,
# broadcasting usa su valor por defecto 'null' y el log usa 'stack'.
FILESYSTEM_DISK=local
RESPONSE_CACHE_ENABLED=false
