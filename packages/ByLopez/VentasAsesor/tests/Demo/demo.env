# Configuracion de la DEMO aislada (sin secretos). La leen demo.sh y todos los procesos que arranca; NO es el .env del proyecto.
# Las variables del proceso tienen prioridad sobre el .env compartido (Laravel carga el .env como inmutable), por eso cada proceso
# (servidor, scheduler, worker, recorridos, verificadores) las recibe EXPLICITAMENTE desde este mismo archivo.
DB_DATABASE=lpz_saas_demo_20261028c
APP_DEBUG=false
MAIL_MAILER=log
QUEUE_CONNECTION=sync
CACHE_STORE=array
RESPONSE_CACHE_ENABLED=false
SESSION_COOKIE=bylopez_demo_session
VENTASASESOR_COMISIONES_FECHA_INICIO=2026-10-26
LOGISTICA_RECAUDO_DESDE_COBRO=2026-10-28
DEMO_HOST=127.0.0.1
DEMO_PORT=8020
